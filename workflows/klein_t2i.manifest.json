{
  "id": "klein_t2i",
  "label": "FLUX.2 klein 4B text-to-image",
  "mode": "text-to-image",
  "kind": "image",
  "variantIds": ["flux2-klein-4b-bf16"],
  "allowedClassTypes": ["UNETLoader", "CLIPLoader", "VAELoader", "CLIPTextEncode", "ConditioningZeroOut", "EmptyFlux2LatentImage", "KSampler", "VAEDecode", "SaveImage"],
  "params": {
    "prompt":  { "node": "4", "input": "text",            "type": "string", "maxLength": 2000 },
    "width":   { "node": "6", "input": "width",           "type": "int", "min": 256, "max": 4096, "multipleOf": 16, "axis": "width" },
    "height":  { "node": "6", "input": "height",          "type": "int", "min": 256, "max": 4096, "multipleOf": 16, "axis": "height" },
    "batch":   { "node": "6", "input": "batch_size",      "type": "int", "min": 1, "max": 4, "default": 1 },
    "seed":    { "node": "7", "input": "seed",            "type": "int", "min": 0, "max": 4294967295 },
    "steps":   { "node": "7", "input": "steps",           "type": "int", "min": 1, "max": 12, "default": 4 },
    "prefix":  { "node": "9", "input": "filename_prefix", "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$", "default": "influencer_studio" }
  }
}
